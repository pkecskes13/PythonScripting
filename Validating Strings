#!/usr/bin/env python3

# Checks whether an input string contains alphanumeric characters,
# letters, digits, lowercase letters, and uppercase letters.
# Prints True or False for each character category.

if __name__ == '__main__':
    s = input()

    print(any(c.isalnum() for c in s))
    print(any(c.isalpha() for c in s))
    print(any(c.isdigit() for c in s))
    print(any(c.islower() for c in s))
    print(any(c.isupper() for c in s))
