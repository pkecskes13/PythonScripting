
#!/usr/bin/env python3

# Evaluates an integer using conditional statements.
# Prints "Weird" or "Not Weird" based on whether the number
# is odd or even and falls within specified numerical ranges.

if __name__ == '__main__':
    n = int(input().strip())

    if n % 2 != 0:
        print("Weird")
    elif n % 2 == 0 and 2 <= n <= 5:
        print("Not Weird")
    elif n % 2 == 0 and 6 <= n <= 20:
        print("Weird")
    else:
        print("Not Weird")
