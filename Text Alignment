#!/usr/bin/env python3

# Generates a scalable block-style letter P using text alignment.

thickness = int(input())
c = 'P'

print((c * (thickness * 3)).ljust(thickness * 3))

for i in range(thickness):
    print((c * thickness).ljust(thickness * 2) + (c * thickness))

print((c * (thickness * 3)).center(thickness * 3))

for i in range(thickness + 1):
    print(c * thickness)
